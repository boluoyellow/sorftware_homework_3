<view class="login-page">
  <view class="login-hero">
    <view class="safe-top"></view>
    <view class="login-header">
      <button class="back-button dark" bindtap="goBack">‹</button>
      <text class="header-caption">设置昵称</text>
      <view class="header-spacer"></view>
    </view>
    <view class="brand-visual">
      <view class="logo-mark">拾</view>
      <view class="orbit"></view>
      <text class="star star-one">✦</text>
      <text class="star star-two">•</text>
    </view>
    <text class="welcome-title">设置昵称</text>
    <text class="welcome-desc">给自己取个称呼，让其他同学更容易认出你</text>
  </view>

  <view class="login-sheet">
    <view class="input-group">
      <text class="input-label">昵称</text>
      <view class="input-shell">
        <text class="field-icon">✎</text>
        <input type="nickname" maxlength="20" value="{{nickname}}" placeholder="展示给其他同学的称呼" placeholder-class="placeholder" bindinput="handleInput" />
      </view>
    </view>

    <view class="login-tip"><text>i</text> 身份由微信云开发自动识别，不需要账号和密码。</view>

    <button class="login-button" loading="{{submitting}}" bindtap="submit">{{submitting ? '正在保存…' : '保存并继续'}} <text wx:if="{{!submitting}}">→</text></button>
    <text class="terms">昵称将随你的发布展示，之后可随时修改</text>
  </view>
</view>
