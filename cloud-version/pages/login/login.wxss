.login-page {
  min-height: 100vh;
  background: #f6f6f1;
}

.login-hero {
  position: relative;
  overflow: hidden;
  height: 610rpx;
  padding: 0 32rpx;
  border-radius: 0 0 70rpx 70rpx;
  background: #173f3a;
  color: #fff;
  text-align: center;
}

.login-hero::before {
  content: '';
  position: absolute;
  width: 430rpx;
  height: 430rpx;
  right: -230rpx;
  top: 40rpx;
  border: 60rpx solid rgba(255,176,32,.08);
  border-radius: 50%;
}

.login-header {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-button.dark {
  background: rgba(255,255,255,.1);
  color: #fff;
  box-shadow: none;
}

.header-caption {
  color: rgba(255,255,255,.6);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.brand-visual {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 40rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-mark {
  position: relative;
  z-index: 2;
  width: 116rpx;
  height: 116rpx;
  border-radius: 38rpx 38rpx 38rpx 12rpx;
  background: #ffb020;
  color: #173f3a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 900;
  transform: rotate(-5deg);
  box-shadow: 0 22rpx 46rpx rgba(0,0,0,.16);
}

.orbit {
  position: absolute;
  inset: 0;
  border: 2rpx dashed rgba(255,203,106,.35);
  border-radius: 50%;
}

.star {
  position: absolute;
  color: #ffcb6a;
}

.star-one { right: -6rpx; top: 20rpx; font-size: 28rpx; }
.star-two { left: 0; bottom: 16rpx; font-size: 42rpx; }

.welcome-title {
  display: block;
  margin-top: 30rpx;
  font-size: 46rpx;
  font-weight: 900;
}

.welcome-desc {
  display: block;
  margin-top: 14rpx;
  color: rgba(255,255,255,.58);
  font-size: 22rpx;
}

.login-sheet {
  position: relative;
  z-index: 2;
  margin: -44rpx 28rpx 0;
  padding: 38rpx 32rpx calc(44rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx;
  background: #fff;
  box-shadow: 0 18rpx 50rpx rgba(23,63,58,.1);
}

.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  margin: 0 0 12rpx 6rpx;
  color: #456a63;
  font-size: 22rpx;
  font-weight: 700;
}

.input-label text {
  margin-left: 8rpx;
  color: #a0afac;
  font-size: 18rpx;
  font-weight: 400;
}

.input-shell {
  height: 88rpx;
  padding: 0 18rpx;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  background: #f4f7f5;
  display: flex;
  align-items: center;
}

.input-shell:focus-within {
  border-color: #ffb020;
  background: #fff;
}

.field-icon {
  width: 46rpx;
  color: #6d8580;
  font-size: 28rpx;
}

.input-shell input {
  flex: 1;
  height: 80rpx;
  color: #173f3a;
  font-size: 25rpx;
}

.placeholder {
  color: #a7b4b1;
}

.eye-button {
  height: 52rpx;
  padding: 0 10rpx;
  background: transparent;
  color: #75908a;
  font-size: 20rpx;
  line-height: 52rpx;
}

.login-tip {
  padding: 17rpx 18rpx;
  border-radius: 18rpx;
  background: #fff8e9;
  color: #947334;
  font-size: 19rpx;
}

.login-tip text {
  display: inline-flex;
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #ffb020;
  color: #173f3a;
  align-items: center;
  justify-content: center;
  font-weight: 900;
}

.login-button {
  width: 100%;
  height: 94rpx;
  margin-top: 30rpx;
  border-radius: 28rpx;
  background: #173f3a;
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 94rpx;
  box-shadow: 0 14rpx 30rpx rgba(23,63,58,.18);
}

.login-button text {
  margin-left: 10rpx;
  color: #ffbf4b;
}

.divider {
  margin: 30rpx 0;
  display: flex;
  align-items: center;
  color: #a2afac;
  font-size: 19rpx;
}

.divider text {
  flex: 1;
  height: 1rpx;
  background: #ebefed;
}

.divider view {
  padding: 0 18rpx;
}

.wechat-button {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid #e1e7e4;
  border-radius: 26rpx;
  background: #fff;
  color: #3e615a;
  font-size: 25rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 14rpx;
  border-radius: 16rpx;
  background: #18b25a;
  color: #fff;
  font-size: 18rpx;
  line-height: 50rpx;
  text-align: center;
}

.terms {
  display: block;
  margin-top: 24rpx;
  color: #a5b1ae;
  font-size: 18rpx;
  text-align: center;
}
