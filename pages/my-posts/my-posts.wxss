.posts-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background: #f6f6f1;
}

.summary-card {
  position: relative;
  overflow: hidden;
  min-height: 210rpx;
  margin: 8rpx 28rpx 0;
  padding: 34rpx;
  border-radius: 36rpx;
  background: #173f3a;
  color: #fff;
  display: flex;
  align-items: center;
}

.summary-copy {
  position: relative;
  z-index: 2;
  flex: 1;
}

.summary-kicker, .summary-title, .summary-desc {
  display: block;
}

.summary-kicker {
  color: #ffcb6a;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.summary-title {
  margin-top: 15rpx;
  font-size: 31rpx;
  font-weight: 900;
}

.summary-desc {
  margin-top: 12rpx;
  color: rgba(255,255,255,.56);
  font-size: 21rpx;
}

.summary-visual {
  width: 110rpx;
  height: 110rpx;
  margin-left: 20rpx;
  border-radius: 38rpx;
  background: #ffb020;
  color: #173f3a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  transform: rotate(5deg);
}

.status-tabs {
  margin: 30rpx 28rpx 0;
  padding: 7rpx;
  border-radius: 24rpx;
  background: #e8edea;
  display: flex;
}

.status-tab {
  flex: 1;
  height: 66rpx;
  padding: 0;
  border-radius: 19rpx;
  background: transparent;
  color: #748a85;
  font-size: 22rpx;
  line-height: 66rpx;
}

.status-tab.active {
  background: #fff;
  color: #173f3a;
  font-weight: 800;
  box-shadow: 0 4rpx 12rpx rgba(23,63,58,.07);
}

.status-tab text {
  margin-left: 5rpx;
  color: #a3b0ad;
  font-size: 18rpx;
}

.posts-list {
  padding: 26rpx 28rpx;
}

.post-wrap {
  margin-bottom: 24rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(23,63,58,.07);
}

.post-wrap item-card .item-card {
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: none;
}

.post-actions {
  min-height: 82rpx;
  padding: 12rpx 18rpx;
  border-top: 1rpx solid #edf0ee;
  display: flex;
  align-items: center;
}

.status-text {
  margin-right: auto;
  color: #728681;
  font-size: 19rpx;
}

.status-text text {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #66c9a1;
}

.status-text.closed text {
  background: #a6b2af;
}

.action-button {
  height: 54rpx;
  margin-left: 10rpx;
  padding: 0 16rpx;
  border-radius: 17rpx;
  font-size: 19rpx;
  line-height: 54rpx;
}

.action-button.solved {
  background: #e5f5ed;
  color: #247154;
}

.action-button.reopen {
  background: #fff2d8;
  color: #a66700;
}

.action-button.delete {
  background: #f6f7f6;
  color: #9a6d69;
}
