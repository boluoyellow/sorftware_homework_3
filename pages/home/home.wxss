.home-page {
  background: #f6f6f1;
}

.hero-area {
  position: relative;
  overflow: hidden;
  padding: 0 32rpx 44rpx;
  border-radius: 0 0 64rpx 64rpx;
  background: #173f3a;
  color: #fff;
}

.hero-area::before {
  content: '';
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  right: -150rpx;
  top: 130rpx;
  border: 54rpx solid rgba(255, 176, 32, 0.16);
  border-radius: 50%;
}

.hero-area::after {
  content: '';
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  right: 115rpx;
  top: 212rpx;
  border-radius: 50%;
  background: #ffb020;
  box-shadow: 52rpx 92rpx 0 rgba(255,255,255,.34), -34rpx 148rpx 0 rgba(255,176,32,.46);
}

.topbar {
  position: relative;
  z-index: 1;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
}

.brand-mark {
  width: 72rpx;
  height: 72rpx;
  margin-right: 18rpx;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  background: #ffb020;
  color: #173f3a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
  transform: rotate(-4deg);
}

.brand-name, .brand-sub {
  display: block;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.brand-sub {
  margin-top: 4rpx;
  color: rgba(255,255,255,.6);
  font-size: 19rpx;
  letter-spacing: 2rpx;
}

.campus-pill {
  height: 58rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(255,255,255,.15);
  border-radius: 999rpx;
  background: rgba(255,255,255,.08);
  color: rgba(255,255,255,.88);
  display: flex;
  align-items: center;
  font-size: 22rpx;
}

.campus-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #72ddaa;
  box-shadow: 0 0 0 6rpx rgba(114,221,170,.13);
}

.hero-copy {
  position: relative;
  z-index: 1;
  padding: 52rpx 10rpx 42rpx;
}

.hero-eyebrow {
  display: block;
  color: #ffcb6a;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

.hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: 56rpx;
  line-height: 1.28;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.hero-title text {
  display: block;
}

.hero-desc {
  display: block;
  width: 500rpx;
  margin-top: 20rpx;
  color: rgba(255,255,255,.66);
  font-size: 24rpx;
  line-height: 1.75;
}

.hero-stats {
  position: relative;
  z-index: 1;
  min-height: 120rpx;
  padding: 22rpx 22rpx 22rpx 28rpx;
  border: 1rpx solid rgba(255,255,255,.12);
  border-radius: 32rpx;
  background: rgba(255,255,255,.08);
  display: flex;
  align-items: center;
}

.stat-block {
  min-width: 120rpx;
}

.stat-number, .stat-label {
  display: block;
}

.stat-number {
  font-size: 36rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 4rpx;
  color: rgba(255,255,255,.55);
  font-size: 19rpx;
}

.stat-divider {
  width: 1rpx;
  height: 54rpx;
  margin: 0 22rpx;
  background: rgba(255,255,255,.16);
}

.hero-action {
  height: 76rpx;
  margin-left: auto;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: #ffb020;
  color: #173f3a;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.content-area {
  padding: 36rpx 28rpx 0;
}

.search-box {
  height: 96rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: #fff;
  border: 1rpx solid rgba(23,63,58,.05);
  box-shadow: 0 12rpx 34rpx rgba(23,63,58,.06);
  display: flex;
  align-items: center;
}

.search-icon {
  margin-right: 18rpx;
  color: #173f3a;
  font-size: 44rpx;
  line-height: 1;
}

.search-input {
  flex: 1;
  height: 80rpx;
  color: #173f3a;
  font-size: 26rpx;
}

.search-placeholder {
  color: #9daca9;
}

.clear-button {
  width: 52rpx;
  height: 52rpx;
  padding: 0;
  border-radius: 18rpx;
  background: #edf1ef;
  color: #6e8580;
  font-size: 34rpx;
  line-height: 48rpx;
}

.section-row {
  margin-top: 42rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 34rpx;
  font-weight: 900;
}

.type-tabs {
  height: 62rpx;
  padding: 6rpx;
  border-radius: 22rpx;
  background: #e9eeeb;
  display: flex;
}

.type-tab {
  min-width: 72rpx;
  height: 50rpx;
  padding: 0 16rpx;
  border-radius: 17rpx;
  background: transparent;
  color: #738984;
  font-size: 22rpx;
  line-height: 50rpx;
}

.type-tab.active {
  background: #fff;
  color: #173f3a;
  font-weight: 800;
  box-shadow: 0 4rpx 12rpx rgba(23,63,58,.07);
}

.category-scroll {
  width: 100%;
  margin: 26rpx 0 30rpx;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  padding-right: 28rpx;
}

.category-chip {
  height: 62rpx;
  margin-right: 16rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #fff;
  color: #637b76;
  font-size: 22rpx;
  line-height: 62rpx;
}

.category-chip.active {
  background: #173f3a;
  color: #fff;
  font-weight: 700;
}

.list-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-start;
}

.grid-cell {
  width: calc(50% - 10rpx);
  margin-bottom: 22rpx;
}
