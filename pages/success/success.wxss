.success-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #173f3a;
  color: #fff;
}

.success-page::before {
  content: '';
  position: absolute;
  width: 620rpx;
  height: 620rpx;
  left: -250rpx;
  top: -190rpx;
  border: 90rpx solid rgba(255,176,32,.08);
  border-radius: 50%;
}

.success-content {
  position: relative;
  z-index: 2;
  min-height: calc(100vh - env(safe-area-inset-top));
  padding: 120rpx 46rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-visual {
  position: relative;
  width: 230rpx;
  height: 230rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.outer-ring {
  position: absolute;
  inset: 0;
  border: 2rpx dashed rgba(255,197,88,.46);
  border-radius: 50%;
}

.success-icon {
  width: 150rpx;
  height: 150rpx;
  border-radius: 52rpx;
  background: #ffb020;
  color: #173f3a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 74rpx;
  font-weight: 900;
  box-shadow: 0 24rpx 50rpx rgba(255,176,32,.26);
  transform: rotate(-4deg);
}

.spark {
  position: absolute;
  color: #ffcb6a;
}

.s1 { right: -10rpx; top: 20rpx; font-size: 32rpx; }
.s2 { left: -4rpx; bottom: 24rpx; font-size: 23rpx; }
.s3 { right: 8rpx; bottom: 16rpx; font-size: 46rpx; }

.success-kicker {
  margin-top: 42rpx;
  color: #ffcb6a;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
}

.success-title {
  margin-top: 16rpx;
  font-size: 58rpx;
  font-weight: 900;
}

.success-desc {
  max-width: 580rpx;
  margin-top: 20rpx;
  color: rgba(255,255,255,.65);
  font-size: 24rpx;
  line-height: 1.8;
  text-align: center;
}

.notice-card {
  width: 100%;
  margin-top: 50rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255,255,255,.12);
  border-radius: 28rpx;
  background: rgba(255,255,255,.07);
  display: flex;
  align-items: center;
}

.notice-icon {
  width: 68rpx;
  height: 68rpx;
  margin-right: 18rpx;
  border-radius: 22rpx;
  background: rgba(255,176,32,.18);
  color: #ffcb6a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.notice-title, .notice-desc {
  display: block;
}

.notice-title {
  font-size: 24rpx;
  font-weight: 800;
}

.notice-desc {
  margin-top: 7rpx;
  color: rgba(255,255,255,.52);
  font-size: 19rpx;
  line-height: 1.55;
}

.view-button, .home-button, .again-button {
  width: 100%;
  height: 94rpx;
  border-radius: 30rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.view-button {
  margin-top: 44rpx;
  background: #ffb020;
  color: #173f3a;
  line-height: 94rpx;
}

.view-button text {
  margin-left: 10rpx;
}

.home-button {
  margin-top: 16rpx;
  border: 1rpx solid rgba(255,255,255,.22);
  background: transparent;
  color: #fff;
  line-height: 92rpx;
}

.again-button {
  margin-top: 10rpx;
  background: transparent;
  color: rgba(255,255,255,.55);
  font-size: 22rpx;
  line-height: 94rpx;
}

.confetti {
  position: absolute;
  width: 12rpx;
  height: 38rpx;
  border-radius: 999rpx;
  background: #ffb020;
  transform: rotate(28deg);
}

.c1 { left: 80rpx; top: 260rpx; }
.c2 { right: 92rpx; top: 350rpx; transform: rotate(-36deg); background: #7bd6b1; }
.c3 { left: 130rpx; bottom: 260rpx; transform: rotate(64deg); background: #fff; opacity: .2; }
.c4 { right: 130rpx; bottom: 190rpx; transform: rotate(10deg); }
