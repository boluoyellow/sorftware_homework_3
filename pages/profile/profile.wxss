.profile-page {
  background: #f6f6f1;
}

.profile-hero {
  padding: 0 30rpx 94rpx;
  border-radius: 0 0 64rpx 64rpx;
  background: #173f3a;
  color: #fff;
}

.profile-topbar {
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-kicker, .hero-heading {
  display: block;
}

.hero-kicker {
  color: #ffcb6a;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

.hero-heading {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 900;
}

.settings-button {
  width: 72rpx;
  height: 62rpx;
  padding: 0;
  border: 1rpx solid rgba(255,255,255,.14);
  border-radius: 22rpx;
  background: rgba(255,255,255,.08);
  color: #fff;
  font-size: 34rpx;
  line-height: 46rpx;
}

.user-card {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  margin-right: 22rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,.16);
  border-radius: 38rpx;
  background: #ffb020;
  color: #173f3a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 900;
}

.avatar-wrap image {
  width: 100%;
  height: 100%;
}

.avatar-wrap.guest {
  background: rgba(255,255,255,.12);
  color: rgba(255,255,255,.7);
}

.online-dot {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid #173f3a;
  border-radius: 50%;
  background: #64d5a4;
}

.user-copy {
  min-width: 0;
  flex: 1;
}

.username, .user-account {
  display: block;
}

.username {
  font-size: 34rpx;
  font-weight: 900;
}

.user-account {
  max-width: 360rpx;
  margin-top: 7rpx;
  overflow: hidden;
  color: rgba(255,255,255,.56);
  font-size: 21rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.user-tag {
  display: inline-block;
  margin-top: 10rpx;
  padding: 7rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(110,225,173,.12);
  color: #8ae5bb;
  font-size: 17rpx;
}

.edit-button {
  width: 90rpx;
  height: 56rpx;
  padding: 0;
  border: 1rpx solid rgba(255,255,255,.16);
  border-radius: 18rpx;
  background: rgba(255,255,255,.08);
  color: #fff;
  font-size: 20rpx;
  line-height: 54rpx;
}

.login-arrow {
  color: #ffcb6a;
  font-size: 42rpx;
}

.profile-content {
  position: relative;
  z-index: 2;
  margin-top: -54rpx;
  padding: 0 28rpx 30rpx;
}

.stats-card {
  min-height: 152rpx;
  padding: 26rpx 12rpx;
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value, .stat-name {
  display: block;
}

.stat-value {
  color: #173f3a;
  font-size: 38rpx;
  font-weight: 900;
}

.stat-value.highlight {
  color: #d78900;
}

.stat-name {
  margin-top: 9rpx;
  color: #829591;
  font-size: 20rpx;
}

.stat-line {
  width: 1rpx;
  height: 56rpx;
  background: #e8ecea;
}

.section-label {
  margin: 38rpx 8rpx 16rpx;
  color: #718681;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.menu-card {
  padding: 0 24rpx;
}

.menu-row {
  width: 100%;
  min-height: 118rpx;
  padding: 18rpx 0;
  background: transparent;
  color: #173f3a;
  display: flex;
  align-items: center;
  text-align: left;
}

.menu-icon {
  width: 70rpx;
  height: 70rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
}

.menu-icon.posts { background: #fff2d8; color: #aa6b00; }
.menu-icon.favorites { background: #fee9e8; color: #d65f55; font-size: 38rpx; }
.menu-icon.service { background: #e5f5ed; color: #247154; font-size: 19rpx; }
.menu-icon.about { background: #e6effd; color: #406ca9; }
.menu-icon.reset { background: #eeeaf8; color: #6a58a2; }

.menu-copy {
  min-width: 0;
  flex: 1;
}

.menu-title, .menu-desc {
  display: block;
}

.menu-title {
  font-size: 25rpx;
  font-weight: 800;
}

.menu-desc {
  margin-top: 6rpx;
  color: #91a09d;
  font-size: 19rpx;
}

.count-badge {
  min-width: 42rpx;
  height: 42rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #fff2d8;
  color: #a66700;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 42rpx;
  text-align: center;
}

.menu-arrow {
  margin-left: 12rpx;
  color: #a9b5b2;
  font-size: 42rpx;
}

.menu-divider {
  height: 1rpx;
  margin-left: 90rpx;
  background: #edf0ee;
}

.logout-button {
  width: 100%;
  height: 84rpx;
  margin-top: 24rpx;
  border-radius: 26rpx;
  background: #fff;
  color: #d45a4c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.footer-slogan {
  display: block;
  margin-top: 28rpx;
  color: #adb8b5;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  text-align: center;
}
