.favorites-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background: #f6f6f1;
}

.header-count {
  min-width: 54rpx;
  height: 54rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  background: #fee9e8;
  color: #d65f55;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 54rpx;
  text-align: center;
}

.collection-banner {
  margin: 12rpx 28rpx 0;
  padding: 28rpx;
  border-radius: 32rpx;
  background: #173f3a;
  color: #fff;
  display: flex;
  align-items: center;
}

.heart-box {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
  border-radius: 26rpx;
  background: #ffb020;
  color: #173f3a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.banner-title, .banner-desc {
  display: block;
}

.banner-title {
  font-size: 27rpx;
  font-weight: 800;
}

.banner-desc {
  margin-top: 7rpx;
  color: rgba(255,255,255,.56);
  font-size: 20rpx;
}

.favorites-list {
  padding: 28rpx;
}

.favorite-cell {
  margin-bottom: 22rpx;
}
