.item-card {
  width: 100%;
  overflow: hidden;
  border-radius: 32rpx;
  background: #fff;
  border: 1rpx solid rgba(23, 63, 58, 0.05);
  box-shadow: 0 12rpx 36rpx rgba(23, 63, 58, 0.07);
}

.item-image {
  position: relative;
  height: 244rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.real-image {
  width: 100%;
  height: 100%;
}

.emoji {
  font-size: 100rpx;
  filter: drop-shadow(0 10rpx 12rpx rgba(23, 63, 58, 0.12));
}

.type-badge {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 46rpx;
  backdrop-filter: blur(8px);
}

.type-badge.lost {
  background: rgba(211, 84, 48, 0.9);
}

.type-badge.found {
  background: rgba(23, 91, 73, 0.9);
}

.type-badge.closed {
  background: rgba(86, 99, 96, 0.9);
}

.item-content {
  padding: 24rpx;
}

.item-topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.item-title {
  min-width: 0;
  flex: 1;
  font-size: 30rpx;
  line-height: 1.35;
  color: #173f3a;
  font-weight: 800;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.favorite {
  flex: none;
  width: 52rpx;
  height: 44rpx;
  padding: 0;
  border-radius: 16rpx;
  background: transparent;
  color: #9eb0ac;
  font-size: 38rpx;
  line-height: 40rpx;
}

.favorite.on {
  color: #e8614f;
}

.item-meta {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  color: #6f8984;
}

.meta-icon {
  margin-right: 8rpx;
  font-size: 25rpx;
}

.meta-text {
  min-width: 0;
  font-size: 23rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.item-bottom {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.category {
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: #f0f4f2;
  color: #4d6c66;
  font-size: 20rpx;
}

.date {
  color: #96a7a3;
  font-size: 20rpx;
}

.compact {
  display: flex;
  min-height: 190rpx;
}

.compact .item-image {
  width: 200rpx;
  height: auto;
  min-height: 190rpx;
  flex: none;
}

.compact .emoji {
  font-size: 72rpx;
}

.compact .item-content {
  flex: 1;
  min-width: 0;
  padding: 24rpx;
}
